# Copy to .env. npm run dev loads it. Keep both origins distinct.
RAX_APP_PORT=3030
RAX_PROXY_PORT=3031
RAX_TRANSFORM_PORT=3032
RAX_BIND=127.0.0.1
# For public binding behind an authenticated gateway ONLY:
# RAX_TRUSTED_GATEWAY=1
RAX_APP_ORIGIN=http://localhost:3030
RAX_PROXY_ORIGIN=http://localhost:3031
# Generate a shared secret only when running transformer/backend separately.
# RAX_TRANSFORM_TOKEN=<random 32-byte hex secret>
# RAX_SOURCE_MAPS=1
# RAX_DEBUG=1
# Test fixtures ONLY. Leave unset in deployed instances.
# RAX_FIXTURE_HOSTS=localhost,127.0.0.1
